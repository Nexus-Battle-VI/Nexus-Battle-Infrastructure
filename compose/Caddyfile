# Proxy inverso de la composicion.
#
# Un unico origen para el navegador, con /api enrutado hacia cada servicio. La
# aplicacion web nunca conoce la topologia: habla siempre con el mismo origen.
# Esa indireccion es lo que permite que la demo corra en una maquina y la
# arquitectura objetivo detras de un balanceador sin cambiar el frontend.

# Las rutas se definen UNA vez y se importan en los dos sitios. Duplicarlas
# garantizaria que algun dia una de las dos copias se quede atras.
(rutas) {
	handle /api/accounts* {
		reverse_proxy account:3000
	}

	handle /api/sessions* {
		reverse_proxy account:3000
	}

	handle /api/inventories* {
		reverse_proxy inventory:3002
	}

	handle /api/products* {
		reverse_proxy catalog:3003
	}

	# Contrato canonico de Catalog (ADR-013, HU-33). Es una ruta DISTINTA de
	# `/api/products*`, no un prefijo suyo, asi que sin esta entrada caia en el
	# comodin de mas abajo y la respondia Web: el navegador recibia el
	# `index.html` de la aplicacion con estado 200 en lugar del producto, que
	# es el peor sintoma posible -no parece un error de enrutado, parece que el
	# servicio devuelve basura-.
	handle /api/v1/catalog* {
		reverse_proxy catalog:3003
	}

	# Administracion del catalogo (HU-34). Incluye
	# `PATCH /api/v1/admin/products/{id}/inventory` y los recursos visuales.
	#
	# Sin esta entrada, la peticion cae en el comodin y la responde Web con un
	# 200 y el `index.html`: el formulario administrativo pareceria funcionar y
	# no ajustaria nada.
	#
	# El servicio exige rol administrativo Y evidencia de segundo factor, asi
	# que publicar la ruta no la deja abierta.
	handle /api/v1/admin* {
		reverse_proxy catalog:3003
	}

	handle /api/internal* {
		respond "Not found" 404
	}

	# `/api/internal*` NO se publica, y esa ausencia es deliberada.
	#
	# Ahi vive el contrato entre servicios -la evidencia de segundo factor de
	# Account y el decremento de inventario de Catalog-, que se llama por la red
	# interna del nodo. Va firmado con HMAC, asi que publicarlo no lo abriria,
	# pero no hay ninguna razon para exponer al mundo una ruta que nadie de
	# fuera puede usar. Si algun dia aparece aqui una entrada `internal`, es un
	# error.

	handle /api/threads* {
		reverse_proxy community:3004
	}

	handle /api/wishlist* {
		reverse_proxy commerce:3005
	}

	handle /api/saved-cart* {
		reverse_proxy commerce:3005
	}

	handle /api/orders* {
		reverse_proxy commerce:3005
	}

	# Los estaticos y el enrutado en el cliente los resuelve la propia imagen
	# de Web, que ya devuelve index.html para rutas desconocidas.
	handle {
		reverse_proxy web:8080
	}

	encode gzip zstd
	log
}

# ---------------------------------------------------------------------------
# Sitio interno: HTTP plano en 8080.
#
# No lleva TLS a proposito. Es el que usan las sondas de salud del contenedor y
# las comprobaciones por SSM contra 127.0.0.1, y tambien el extremo de un tunel
# de Session Manager. Nada de eso sale de la maquina, asi que cifrarlo no
# protegeria de nada y complicaria las sondas.
#
# Este puerto NO debe abrirse en el grupo de seguridad.
# ---------------------------------------------------------------------------
:8080 {
	import rutas
}

# ---------------------------------------------------------------------------
# Sitio publico.
#
# `SITIO_PUBLICO` decide la direccion, y con ella el certificado:
#
#   sin definir      -> `localhost:8443`, que nadie alcanza porque el puerto no
#                       se publica. Es el estado por defecto: el sistema no esta
#                       expuesto.
#   una IP           -> certificado de la CA local de Caddy. El navegador avisa.
#   un dominio       -> con `TLS_CONTACTO` puesto a un correo, Caddy obtiene un
#                       certificado real de Let's Encrypt y el aviso desaparece.
#
# HTTPS y no HTTP, y no por gusto: **Cognito rechaza URL de retorno que no sean
# HTTPS**, salvo `localhost`. Exponer esto por HTTP plano daria un sistema
# alcanzable en el que nadie podria iniciar sesion.
# ---------------------------------------------------------------------------
{$SITIO_PUBLICO:localhost:8443} {
	# `internal` usa la CA local. Un correo activa ACME contra Let's Encrypt,
	# que necesita un dominio publico resoluble y el puerto 80 alcanzable.
	tls {$TLS_CONTACTO:internal}

	import rutas
}
