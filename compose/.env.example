# Variables de la composición de referencia.
#
# Se copia a `.env` JUNTO a `compose.yml`, que es donde Docker Compose lo busca.
# Este fichero no contiene ningun secreto real. Los marcadores sensibles quedan
# vacios o usan valores locales de ejemplo y deben sustituirse fuera de Git.

# --- Verificación de identidad --------------------------------------------
# disabled: ningún servicio comprueba quién realiza la petición. Es el estado
#           que describe el BLOCKER de ADR-004, no una opción de conveniencia.
# jwt:      los cinco servicios HTTP exigen un testimonio firmado por el pool.
#
# Con `NODE_ENV=production`, `disabled` IMPIDE ARRANCAR el binario. Es
# deliberado: un aviso en el registro se pasa por alto, un arranque que falla no.
AUTH_MODE=disabled

# Valores REALES del entorno ya aprovisionado (`infra/envs/prod`), no de un
# doble. No son secretos: el cliente se registró SIN secreto de cliente —uno
# embebido en el paquete servido al navegador es público por definición— y su
# identificador viaja en la propia URL de inicio de sesión.
COGNITO_USER_POOL_ID=us-east-1_HrEiSzzKW
COGNITO_CLIENT_ID=vqtjlpsemjr5kjtsb97fnr1qp

# --- Contrato interno entre servicios -------------------------------------
# Misma clave en Account, Catalog, Commerce, Inventory, Notifications y
# Community. Firma la evidencia de segundo factor, reservas, entregas, correos
# de compra y el promedio de calificaciones que Community empuja hacia
# Catalog (HU-40, CA-03). En Community es OPCIONAL -a diferencia del resto-:
# sin ella, calificar sigue funcionando y Catalog no recibe el agregado.
#
# Obligatoria para validar/arrancar el compose integrado. No guardar una clave
# de produccion en Git. El ejemplo no inventa una clave compartida por defecto.
INTERNAL_SERVICE_AUTH_SECRET=
# Tiempo maximo de las consultas internas, en las dos direcciones.
INTERNAL_TIMEOUT_MS=2000

# --- Lo que este fichero NO puede cambiar ---------------------------------
# La identidad de `web` no se configura aquí. Sus variables `VITE_` se
# resuelven al COMPILAR la imagen, no al arrancar el contenedor, así que
# declararlas en `environment` no tendría ningún efecto. Para cambiarlas hay que
# reconstruir la imagen con los valores que documenta el `.env.example` de
# Nexus-Battle-Web.

# --- Moderación automática de comentarios (HU-41.7, Management#29) --------
# Consumidas UNICAMENTE por Community (`ConfigurableCommentContentModerationPolicy`).
# Cada coincidencia solo genera una senal `AUTOMATIC_FILTER` en la cola de
# moderacion que ya existe para revision humana: el filtro NUNCA oculta,
# elimina ni sanciona por si solo, ni llama a otro servicio.
#
# Formato EXACTO que Community interpreta (no inventar otro):
#   - lista separada por comas;
#   - cada elemento se recorta de espacios; los vacios se descartan;
#   - COMMENT_MODERATION_FORBIDDEN_TERMS: subcadena, insensible a mayusculas.
#   - COMMENT_MODERATION_SUSPICIOUS_PATTERNS: cada elemento se compila como
#     expresion regular (insensible a mayusculas). Un patron que no compila
#     impide arrancar Community -a proposito, para no descubrirlo en
#     produccion con el primer comentario que lo ejercite-.
#
# AMBAS SON OPCIONALES. Vacio es una configuracion valida: Community arranca
# igual y el filtro automatico simplemente no genera ninguna senal.
#
# Infrastructure NO define aqui la politica funcional -que terminos o patrones
# son reales-: eso lo decide cada ambiente, fuera de este repositorio. No se
# versiona una lista real de insultos, marcas ni terminos ofensivos.
#
# Para pruebas se permite EXCLUSIVAMENTE un valor sintetico, por ejemplo
# `forbidden-test-term`; no representa una regla funcional de Nexus Battles.
COMMENT_MODERATION_FORBIDDEN_TERMS=
COMMENT_MODERATION_SUSPICIOUS_PATTERNS=

# --- Credenciales de las bases ---------------------------------------------
# La usan `POSTGRES_PASSWORD`, `MONGO_INITDB_ROOT_PASSWORD` y los scripts de
# inicializacion que crean un usuario por servicio. Antes esos usuarios tenian
# la palabra `cambiar` escrita en el fichero, de modo que sustituir la variable
# solo cambiaba la del superusuario.
#
# `cambiar` es correcto en desarrollo y esta declarado como ejemplo. En una
# instancia real la pone Terraform desde `db_password`.
DB_PASSWORD=cambiar
