# Variables de la composición de referencia.
#
# Se copia a `.env` JUNTO a `compose.yml`, que es donde Docker Compose lo busca.
# Ninguna de estas variables es un secreto; las credenciales de las bases de
# datos siguen en claro dentro del propio compose, y siguen siendo de ejemplo.

# --- Verificación de identidad --------------------------------------------
# disabled: ningún servicio comprueba quién realiza la petición. Es el estado
#           que describe el BLOCKER de ADR-004, no una opción de conveniencia.
# jwt:      los cinco servicios HTTP exigen un testimonio firmado por el pool.
#
# Con `NODE_ENV=production`, `disabled` IMPIDE ARRANCAR el binario. Es
# deliberado: un aviso en el registro se pasa por alto, un arranque que falla no.
AUTH_MODE=disabled

# Valores REALES del entorno ya aprovisionado (`infra/envs/prod`), no de un
# doble. No son secretos: el cliente se registró SIN secreto de cliente —uno
# embebido en el paquete servido al navegador es público por definición— y su
# identificador viaja en la propia URL de inicio de sesión.
COGNITO_USER_POOL_ID=us-east-1_HrEiSzzKW
COGNITO_CLIENT_ID=vqtjlpsemjr5kjtsb97fnr1qp

# --- Lo que este fichero NO puede cambiar ---------------------------------
# La identidad de `web` no se configura aquí. Sus variables `VITE_` se
# resuelven al COMPILAR la imagen, no al arrancar el contenedor, así que
# declararlas en `environment` no tendría ningún efecto. Para cambiarlas hay que
# reconstruir la imagen con los valores que documenta el `.env.example` de
# Nexus-Battle-Web.

# --- Credenciales de las bases ---------------------------------------------
# La usan `POSTGRES_PASSWORD`, `MONGO_INITDB_ROOT_PASSWORD` y los scripts de
# inicializacion que crean un usuario por servicio. Antes esos usuarios tenian
# la palabra `cambiar` escrita en el fichero, de modo que sustituir la variable
# solo cambiaba la del superusuario.
#
# `cambiar` es correcto en desarrollo y esta declarado como ejemplo. En una
# instancia real la pone Terraform desde `db_password`.
DB_PASSWORD=cambiar
