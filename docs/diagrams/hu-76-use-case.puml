@startuml hu-76-use-case
title HU-76 — Logros de misiones (casos de uso)
left to right direction
skinparam packageStyle rectangle

actor "Jugador" as Player
actor "Evaluador de logros\n(tras el cierre de HU-72)" as Evaluator
actor "Player/Inventory\n(Team Alfa)" as Inventory

rectangle "Missions (Team Beta)" {
  usecase "Actualizar el progreso\ncon el hecho normalizado" as UC1
  usecase "Evaluar criterios\n(CA-02, CA-03)" as UC2
  usecase "Registrar el logro y su\nreconocimiento (CA-01)" as UC3
  usecase "Pedir la entrega\nde un cosmético" as UC4
  usecase "Consultar mis logros" as UC5
}

Evaluator --> UC1
UC1 ..> UC2 : <<include>>
UC2 ..> UC3 : <<include>>
UC4 ..> UC3 : <<extend>>
UC4 --> Inventory
Player --> UC5

note right of UC5
  Web solo consulta: nunca decide
  si un logro se cumplió.
end note
@enduml
