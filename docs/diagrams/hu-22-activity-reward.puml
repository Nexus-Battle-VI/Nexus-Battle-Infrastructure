@startuml hu-22-activity-reward
title HU-22 — Actividad: de BattleResult a recompensa entregada

start
:BattleResult terminal (HU-21);
:leer credits/victoryCredits del participante\n(BattleCreditsPolicy, ya implementada);
:persistir RewardWorkflow (PENDING_CREDIT);
:POST Wallet credits/battle-reward (operationId determinista);

if (Wallet respondió?) then (sí)
  :leer balance, victoryProgress, weeklyChestCount, chestEarned;
else (no)
  if (422 / 409 con cuerpo distinto?) then (terminal)
    :estado TERMINAL_FAILURE;
    stop
  else (503 / timeout, transitorio)
    :registrar el intento fallido, SIN cambiar de estado\n(sigue en PENDING_CREDIT; corregido 2026-09-22:\nno es un estado propio, ver contrato §8.1);
    :el barrido periódico reintenta el mismo operationId;
    stop
  endif
endif

if (chestEarned?) then (sí)
  :estado CHEST_ELIGIBLE;
  :BATTLE_RANDOM_SEQUENCE.nextIndex() (1..8000, MISMA secuencia de proceso\nque turnos/ataques -- no una nueva);
  :RewardTable.resolve(index) -> producto (40 tramos, mismo espacio que HU-25);
  :persistir REWARD_SELECTED (productId fijo, no se vuelve a sortear);
  :POST Player-Inventory grants (operationId determinista, productId, quantity 1);
  if (Inventory confirmó?) then (sí)
    :estado COMPLETED (con cofre);
  else (no)
    if (422 / 409 con cuerpo distinto?) then (terminal)
      :estado TERMINAL_FAILURE;
      :créditos YA confirmados quedan firmes;\nWeb muestra rewardDelivery: FAILED (corregido 2026-09-22),\nnunca "entregado" ni "procesando" para siempre;
      stop
    else (503 / timeout, transitorio)
      :registrar el intento fallido, SIN cambiar de estado\n(sigue en REWARD_SELECTED, mismo productId);
      :el barrido periódico reintenta;
      stop
    endif
  endif
else (no)
  :estado COMPLETED (sin cofre);
endif

:Web se entera por SONDEO (corregido 2026-09-22 --\nno hay push realtime, ver diagrama de secuencia):\nGET .../reward cada 1500 ms hasta un estado final;
stop
@enduml
