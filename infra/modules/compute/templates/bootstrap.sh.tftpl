#!/bin/bash
# ---------------------------------------------------------------------------
# Arranque del nodo. Lo ejecuta cloud-init una sola vez, en el primer boot.
#
# Todo lo que hace este script esta en Terraform y no en un comando escrito a
# mano por SSM: un nodo que se recrea vuelve al mismo estado sin que nadie
# recuerde que hizo la vez anterior.
# ---------------------------------------------------------------------------
set -euo pipefail

exec > >(tee -a /var/log/nexus-bootstrap.log) 2>&1
echo "[nexus] arranque del nodo '${rol}' a las $(date --iso-8601=seconds)"

%{~ if rol == "data" && montar_volumen_datos ~}
# ---------------------------------------------------------------------------
# El volumen de datos, ANTES de instalar Docker
#
# El orden no es una preferencia: Docker crea `/var/lib/docker/volumes` al
# arrancar y escribe ahi los volumenes. Montar despues dejaria los datos en el
# volumen raiz, que desaparece con la instancia, y todo pareceria correcto hasta
# el primer reemplazo.
#
# SE ESPERA AL DISPOSITIVO. Terraform adjunta el volumen DESPUES de crear la
# instancia, asi que en el primer arranque puede no existir todavia.
#
# Y si no llega, el arranque FALLA a proposito. La alternativa -seguir sin
# volumen- dejaria un nodo que parece sano guardando las bases donde se van a
# perder, que es justo el fallo que este bloque existe para evitar.
# ---------------------------------------------------------------------------
dispositivo_datos() {
  for candidato in /dev/sdf /dev/xvdf /dev/nvme1n1; do
    if [ -b "$candidato" ]; then
      echo "$candidato"
      return 0
    fi
  done

  return 1
}

DISPOSITIVO=""
for intento in $(seq 1 60); do
  if DISPOSITIVO="$(dispositivo_datos)"; then
    echo "[nexus] volumen de datos en $DISPOSITIVO tras $((intento * 5))s"
    break
  fi
  sleep 5
done

if [ -z "$DISPOSITIVO" ]; then
  echo "[nexus] ERROR: el volumen de datos no aparecio en 300s."
  echo "[nexus] No se arranca nada: las bases irian al volumen raiz y se perderian."
  exit 1
fi

# Formatear SOLO si no hay sistema de ficheros. Formatear "por si acaso" seria
# el mismo desastre por otra via: un volumen con datos quedaria vacio y el
# arranque saldria en verde.
if ! blkid "$DISPOSITIVO" >/dev/null 2>&1; then
  echo "[nexus] el volumen esta vacio; se formatea con XFS"
  mkfs.xfs "$DISPOSITIVO"
else
  echo "[nexus] el volumen ya tiene sistema de ficheros; NO se formatea"
fi

install -d /var/lib/docker/volumes
UUID_DATOS="$(blkid -s UUID -o value "$DISPOSITIVO")"

if ! grep -q "$UUID_DATOS" /etc/fstab; then
  # `nofail` para que un volumen ausente no deje la maquina sin arrancar: se
  # prefiere un nodo accesible en el que se vea el problema.
  echo "UUID=$UUID_DATOS /var/lib/docker/volumes xfs defaults,nofail 0 2" >> /etc/fstab
fi

mount /var/lib/docker/volumes
echo "[nexus] volumen de datos montado en /var/lib/docker/volumes"
%{~ endif ~}

# ---------------------------------------------------------------------------
# Docker
#
# `docker` SI esta en los repositorios de AL2023 (25.0.16 a fecha de hoy,
# comprobado con `dnf list --available` en el propio nodo).
# ---------------------------------------------------------------------------
dnf install -y docker
systemctl enable --now docker

# ---------------------------------------------------------------------------
# El complemento `compose`
#
# NO esta en los repositorios de AL2023: la misma comprobacion que encontro
# `docker` no devolvio `docker-compose-plugin`. Se descarga del proyecto
# oficial, con la version FIJADA y la huella verificada antes de darle permiso
# de ejecucion.
#
# Fijar la version importa: `latest` convierte cada recreacion del nodo en una
# actualizacion no decidida. Y verificar la huella importa mas: sin esa linea,
# el nodo ejecuta como root lo que le haya devuelto la red.
# ---------------------------------------------------------------------------
install -d /usr/local/lib/docker/cli-plugins
curl -fsSL -o /tmp/docker-compose "${compose_url}"
echo "${compose_sha256}  /tmp/docker-compose" | sha256sum -c -
install -m 0755 /tmp/docker-compose /usr/local/lib/docker/cli-plugins/docker-compose
rm -f /tmp/docker-compose

docker compose version

# ---------------------------------------------------------------------------
# La composicion del nodo
# ---------------------------------------------------------------------------
install -d /opt/nexus
cat > /opt/nexus/compose.yml <<'NEXUS_COMPOSE_EOF'
${compose}
NEXUS_COMPOSE_EOF

%{ for nombre, contenido in ficheros ~}
cat > /opt/nexus/${nombre} <<'NEXUS_FICHERO_EOF'
${contenido}
NEXUS_FICHERO_EOF
%{ endfor ~}

# `cat` no conserva el bit de ejecucion. Importa: el entrypoint de la imagen de
# PostgreSQL EJECUTA los `.sh` de `docker-entrypoint-initdb.d` si son
# ejecutables y los SOURCEA si no, y sourcear uno con `set -euo pipefail`
# dejaria esas opciones activas en la shell del propio entrypoint.
chmod +x /opt/nexus/*.sh 2>/dev/null || true

# El `.env` que acompana a la composicion. Se escribe con permisos 0600: lleva
# la contrasena de las bases, y `user_data` ya es legible desde la instancia por
# quien pueda consultar los metadatos, asi que no hace falta ampliarlo mas.
umask 077
cat > /opt/nexus/.env <<'NEXUS_ENV_EOF'
%{ for clave, valor in entorno ~}
${clave}=${valor}
%{ endfor ~}
NEXUS_ENV_EOF
chmod 0600 /opt/nexus/.env
umask 022

%{~ if rol == "data" ~}
# ---------------------------------------------------------------------------
# El fichero de clave del conjunto de replicas
#
# NO VIAJA POR TERRAFORM, y es deliberado: el estado guarda `user_data` entero y
# sin cifrar, asi que una clave generada con `random_password` acabaria en el
# fichero de estado. Generarla aqui la deja solo en el disco del nodo.
#
# Vive en `/opt/nexus`, que esta en el volumen RAIZ: sobrevive a un reinicio,
# NO a un reemplazo del nodo. Con un solo miembro eso no rompe nada -no hay par
# al que autenticarse-, pero deja de ser cierto el dia que el conjunto tenga
# tres, y entonces la clave tendra que venir de un origen compartido. Queda
# dicho aqui para que ese dia no se descubra por sorpresa.
#
# 0400 y dueno 999, que es el usuario `mongodb` de la imagen oficial: mongod
# RECHAZA arrancar con un keyfile mas abierto.
# ---------------------------------------------------------------------------
install -d -m 0700 /opt/nexus/secrets

if [ ! -s /opt/nexus/secrets/mongo-keyfile ]; then
  openssl rand -base64 756 > /opt/nexus/secrets/mongo-keyfile
  echo "[nexus] fichero de clave del conjunto de replicas generado"
else
  echo "[nexus] el fichero de clave ya existia; se conserva"
fi

chmod 0400 /opt/nexus/secrets/mongo-keyfile
chown 999:999 /opt/nexus/secrets/mongo-keyfile
%{~ endif ~}

%{~ if rol == "app" && arrancar_stack ~}
# ---------------------------------------------------------------------------
# El plano de aplicacion espera a que el de datos escuche
#
# Terraform crea las dos instancias EN PARALELO, y `depends_on` de compose ordena
# contenedores dentro de una maquina, no entre maquinas. En el primer arranque
# real las cinco migraciones murieron con `ECONNREFUSED 10.42.1.20:5432` porque
# `app` llego antes que `data`; en el segundo salieron bien solo porque `data`
# termino ocho segundos antes. Eso es suerte, no orden.
#
# Se espera con un limite. Si el plano de datos no esta listo, el arranque
# termina con error antes de lanzar migraciones.
#
# `/dev/tcp` es de bash y no necesita instalar nada.
# ---------------------------------------------------------------------------
esperar_puerto() {
  destino="$1"
  puerto="$2"
  intento=0

  while [ "$intento" -lt 90 ]; do
    if timeout 2 bash -c "echo > /dev/tcp/$destino/$puerto" 2>/dev/null; then
      echo "[nexus] $destino:$puerto responde tras $((intento * 2))s"
      return 0
    fi

    intento=$((intento + 1))
    sleep 2
  done

  echo "[nexus] ERROR: $destino:$puerto no respondio en 180s; no se ejecutan migraciones"
  return 1
}

esperar_puerto "${data_host}" 5432
esperar_puerto "${data_host}" 27017

# El puerto abierto tambien responde durante la inicializacion del replica set.
# Las transacciones de Catalog e Inventory necesitan un primario de rs0. hello
# es el comando publico de descubrimiento: no requiere credenciales de usuario.
# La imagen ya es la misma que usa el plano de datos; no instala otro cliente.
docker run --rm --entrypoint mongosh mongo:8 \
  "mongodb://${data_host}:27017/?directConnection=true&serverSelectionTimeoutMS=5000&connectTimeoutMS=5000" \
  --quiet --eval '
    const limite = Date.now() + 180000;
    while (Date.now() < limite) {
      let primario = false;
      try {
        const estado = db.hello();
        primario = estado.setName === "rs0" && estado.isWritablePrimary;
      } catch (error) {
        // La eleccion puede cerrar una conexion; se reintenta dentro del limite.
      }
      if (primario) {
        print("[nexus] Mongo rs0 tiene primario; se pueden ejecutar migraciones");
        quit(0);
      }
      sleep(2000);
    }
    print("[nexus] ERROR: Mongo rs0 no eligio primario en 180s");
    quit(1);
  '
%{~ endif ~}

# ---------------------------------------------------------------------------
# Arrancar, o no
#
# `arrancar_stack` es `false` por defecto y NO es una precaucion generica: la
# composicion de referencia declara las contrasenas de las bases como la
# palabra literal `cambiar`. Levantar con eso un nodo real seria crear un
# sistema con credenciales conocidas y llamarlo desplegado.
#
# El nodo queda listo —Docker instalado, complemento verificado, composicion
# escrita— y el ultimo paso espera a que exista un origen real de credenciales.
# ---------------------------------------------------------------------------
%{ if arrancar_stack ~}
cd /opt/nexus
docker compose up -d
echo "[nexus] stack arrancado"
%{ else ~}
echo "[nexus] nodo preparado; el stack NO se arranca (arrancar_stack = false)"
echo "[nexus] para arrancarlo a mano: cd /opt/nexus && docker compose up -d"
%{ endif ~}
