# Se copia a `terraform.tfvars` y se rellena. El fichero real esta ignorado por
# git: este repositorio es publico y `terraform.tfvars` contiene el identificador
# de cuenta y una direccion de correo.

account_id  = "000000000000"
alert_email = "alertas@ejemplo.invalid"

# Se define en el terraform.tfvars real, que esta ignorado por Git. Debe ser el
# mismo valor para Account y Catalog. Vacio mantiene el contrato fail-closed.
internal_service_auth_secret = ""

# ---------------------------------------------------------------------------
# Filtro automatico de contenido de Community (HU-41.7, Management#29)
# ---------------------------------------------------------------------------
#
# AMBAS OPCIONALES y vacias por defecto: Community arranca igual y el filtro
# simplemente no genera ninguna deteccion. Este repositorio NO define la
# politica funcional -que terminos o patrones son reales lo decide cada
# ambiente, y no se versiona una lista real de insultos, marcas ni terminos
# ofensivos-.
#
# Formato que Community interpreta (ver `compose/.env.example`): lista
# separada por comas, cada elemento recortado de espacios.
#
# Para pruebas se permite EXCLUSIVAMENTE un valor sintetico:
# comment_moderation_forbidden_terms     = "forbidden-test-term"
# comment_moderation_suspicious_patterns = ""

# Topologia T2 (ADR-011): plano sin estado separado del plano con estado.
#
# El criterio no es cuantos microservicios hay, sino que componentes tienen
# ciclos de vida operativos opuestos: las aplicaciones se redespliegan en cada
# integracion, las bases de datos no deben reiniciarse nunca.
#
# Cambiar de topologia es editar este mapa y ejecutar `terraform plan`.
# Para una instancia por servicio, anadir un nodo con rol "app" por cada uno.
# ADR-011 explica por que no se hizo: consume el 92 % del techo mensual y
# multiplica por ocho la probabilidad de que algo este caido, sin ganar alta
# disponibilidad, porque sigue habiendo una sola zona y ningun reemplazo
# automatico.
nodes = {
  app = {
    instance_type = "t4g.small" # 1340 MiB necesarios de 2048
    role          = "app"
    volume_gb     = 20
    # Direccion FIJA: el plano de aplicacion necesita saber donde esta el de
    # datos antes de arrancar, y leerlo del otro recurso seria una
    # autorreferencia dentro del mismo `for_each`.
    private_ip    = "10.42.1.10"
  }
  data = {
    instance_type = "t4g.small" # 972 MiB necesarios de 2048
    role          = "data"
    volume_gb     = 20
    private_ip    = "10.42.1.20"
  }
}

# VACIO A PROPOSITO. Ver ADR-004: mientras ningun servicio verifique quien
# realiza la peticion, abrir esto publica un sistema donde cualquiera puede
# confirmar pedidos a nombre de otra persona, ocultar mensajes o cambiar precios.
#
# Cuando el BLOCKER se cierre, aqui van los origenes autorizados.
public_ingress_cidrs = []

# Segunda aplicacion, un dia despues: AWS necesita ver la etiqueta en un recurso
# real antes de permitir activarla.
activate_cost_allocation_tags = false

# ---------------------------------------------------------------------------
# Segundo factor por correo (ADR-004)
# ---------------------------------------------------------------------------
#
# Las tres van juntas: `mfa_method = "email"` sin identidad de SES falla en el
# PLAN, con un mensaje que dice la causa. Dejarlas vacias mantiene el emisor por
# defecto de Cognito y el segundo factor en aplicacion autenticadora.
#
# La identidad tiene que estar verificada ANTES. Terraform no la crea: verificar
# una direccion exige que una persona abra un correo y pulse un enlace.
#
# LIMITE REAL DE ESTA CUENTA: SES esta en el entorno de pruebas y la solicitud
# para salir de el fue DENEGADA. Solo se puede escribir a direcciones ya
# verificadas, asi que el segundo factor por correo llega a las cuentas
# administrativas cuyo correo lo este, y a nadie mas.
#
# ses_identity_arn   = "arn:aws:ses:us-east-1:658430303197:identity/nexusbattle67@gmail.com"
# from_email_address = "nexusbattle67@gmail.com"
# mfa_method         = "email"

# ---------------------------------------------------------------------------
# Exposicion (ADR-004)
# ---------------------------------------------------------------------------
#
# LAS TRES VAN JUNTAS. Poner una sin las otras deja el sistema roto de una forma
# distinta cada vez:
#
#   public_ingress_cidrs  sin  public_site_address  -> puertos abiertos donde el
#                                                      proxy no sirve nada util
#   public_site_address   sin  public_ingress_cidrs -> el proxy sirve HTTPS y
#                                                      nadie llega
#   cualquiera de las dos sin actualizar `callback_urls` del cliente de Cognito
#                                                   -> el retorno del inicio de
#                                                      sesion falla con
#                                                      `redirect_mismatch`
#
# Cognito RECHAZA URL de retorno que no sean HTTPS, salvo `localhost`. Exponerlo
# por HTTP plano da un sistema alcanzable donde nadie puede iniciar sesion.
#
# Con una IP, Caddy usa su CA local y el navegador avisa. Y la IP publica del
# nodo CAMBIA al reemplazarlo, asi que la URL de retorno se rompe en cada
# despliegue: para algo estable hace falta un dominio, o una IP elastica.
#
# ANTES DE ABRIR A 0.0.0.0/0, LEER ESTO: el pool tiene `mfa_configuration` en
# OPTIONAL y ningun usuario tiene segundo factor configurado. Quien entre por el
# hosted UI obtiene un testimonio SIN segundo factor, y si esa cuenta esta en
# ADMINISTRATOR los otros cuatro servicios lo honran. El `LoginAccount` que falla
# cerrado solo protege la ruta de Account, no ese camino. Forzar MFA para todos
# no es viable mientras SES siga en el entorno de pruebas, porque solo llegaria
# a direcciones verificadas y dejaria fuera a los jugadores.
#
# public_ingress_cidrs = ["203.0.113.4/32"]
# public_site_address  = "nexus.ejemplo.com"
# tls_contact_email    = "operaciones@ejemplo.com"
#
# CON UN DOMINIO PROPIO, que es lo que se quiere para ensenarlo:
#
#   public_site_address  = "nexus.midominio.app"
#   tls_contact_email    = "operaciones@midominio.app"
#   public_ingress_cidrs = ["0.0.0.0/0"]
#
# Poner las dos primeras hace tres cosas solo, sin que haya que acordarse:
#
#   1. Reserva una IP ELASTICA para el nodo `app`, para que su direccion
#      sobreviva a los reemplazos. Sin ella, cada despliegue rompe a la vez el
#      registro DNS, el certificado y las URL de retorno.
#   2. Abre el puerto 80 a TODO INTERNET. No es una eleccion: Let's Encrypt
#      valida desde direcciones que no publica y desaconseja filtrarlas. En ese
#      puerto el proxy solo sirve el reto de ACME y una redireccion.
#   3. Anade el origen a `callback_urls` y `logout_urls` del cliente de Cognito.
#      Olvidarlo dejaria el sistema alcanzable con el inicio de sesion roto por
#      `redirect_mismatch`, y ese error no menciona esta variable.
#
# `public_ingress_cidrs` sigue gobernando el 443, que es por donde pasa todo lo
# demas. Ahi si cabe restringir.
#
# EL ORDEN IMPORTA: aplicar primero, leer la salida `registro_dns_necesario`,
# crear el registro A, y esperar. Caddy reintenta solo hasta que el DNS resuelve.

# ---------------------------------------------------------------------------
# UNA ADVERTENCIA SOBRE `-var` EN LA LINEA DE ORDENES
# ---------------------------------------------------------------------------
#
# Estos valores van AQUI, en `terraform.tfvars`, no en banderas `-var`.
#
# Terraform no recuerda las banderas de un apply anterior. Aplicar una vez con
#
#   terraform apply -var 'public_ingress_cidrs=["0.0.0.0/0"]'
#
# y la siguiente sin ella no deja las cosas como estaban: BORRA la regla, porque
# el valor vuelve a su defecto. Y lo hace sin avisar de nada raro, porque para
# Terraform es exactamente lo que se le pidio.
#
# El fichero es el unico sitio donde la configuracion sobrevive entre applys.
# Esta ignorado por git a proposito -contiene la contrasena de las bases- y por
# eso existe este ejemplo.
